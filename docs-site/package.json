{
  "name": "@recite/docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun astro dev",
    "build": "bun run --bun astro build",
    "preview": "bun run --bun astro preview --host 127.0.0.1",
    "check": "bun run --bun astro sync && bun run --bun astro check --minimumFailingSeverity warning && tsc --noEmit -p tsconfig.typescript.json && bun run lint:css",
    "test:browser": "playwright test",
    "test:content": "bun run --cwd .. js:test --project site",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/starlight": "0.42.4",
    "astro": "7.3.5",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
