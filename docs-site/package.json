{
  "name": "@recite/docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --bun node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.mjs --serve --watch",
    "build": "bun --bun node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.mjs",
    "preview": "bun tools/serve.ts",
    "check": "tsc --noEmit -p tsconfig.json && bun run lint:css",
    "test:browser": "playwright test",
    "test:content": "bun run --cwd .. js:test docs-site/tests",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.7",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hono": "4.13.13",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "pagefind": "1.5.2",
    "shiki": "4.5.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
