---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

const isHome = Astro.url.pathname === getRelativeLocaleUrl(Astro.currentLocale ?? "en", "");
---

{isHome ? (
  <div class="landing-title">
    <p>Recite</p>
    <h1 id="_top">{Astro.locals.t("landing.title")}</h1>
  </div>
) : (
  <Default />
)}
