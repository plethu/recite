---
import { getRelativeLocaleUrl } from "astro:i18n";

const t = Astro.locals.t;
const url = (path: string) => getRelativeLocaleUrl(Astro.currentLocale ?? "en", path);
---

<div class="landing-intro">
  <p class="landing-lead">{t("landing.lead")}</p>
  <p class="landing-release">{t("landing.release")}</p>
  <p class="landing-release-links">
    <a href={url("getting-started/install")}>{t("landing.release.install")}</a>
    <a href={url("guides/distribution")}>{t("landing.release.packages")}</a>
  </p>
  <p class="landing-actions">
    <a class="landing-primary" href={url("getting-started/first-scene")}>
      {t("landing.action.firstScene")}
    </a>
    <a href={url("reference/source-format")}>{t("landing.action.sourceFormat")}</a>
  </p>
</div>

<section class="landing-scene" aria-labelledby="scene-heading">
  <div class="landing-section-heading">
    <div>
      <p class="landing-kicker">{t("landing.scene.kicker")}</p>
      <h2 id="scene-heading">{t("landing.scene.title")}</h2>
    </div>
  </div>
  <figure class="scene">
    <div class="scene-script">
      <p class="scene-direction">{t("landing.scene.opening")}</p>
      <p>
        <span class="scene-speaker">{t("landing.scene.technician")}</span>
        {t("landing.scene.again")}
      </p>
      <p>
        <span class="scene-speaker">{t("landing.scene.recording")}</span>
        {t("landing.scene.directions")}
      </p>
      <p class="scene-direction">{t("landing.scene.tape")}</p>
      <p><span class="scene-action">{t("landing.scene.power")}</span></p>
      <p class="scene-direction">{t("landing.scene.powerResult")}</p>
      <p><span class="scene-action">{t("landing.scene.plan")}</span></p>
      <p class="scene-direction">{t("landing.scene.planResult")}</p>
      <p class="scene-direction">{t("landing.scene.choose")}</p>
    </div>
  </figure>
</section>

<section class="landing-paths" aria-labelledby="paths-heading">
  <div class="landing-section-heading">
    <div>
      <p class="landing-kicker">{t("landing.path.kicker")}</p>
      <h2 id="paths-heading">{t("landing.path.title")}</h2>
    </div>
  </div>
  <div class="landing-path-grid">
    <div>
      <h3>{t("landing.write.title")}</h3>
      <p>{t("landing.write.body")}</p>
      <a href={url("guides/authoring-loop")}>{t("landing.write.link")}</a>
    </div>
    <div>
      <h3>{t("landing.check.title")}</h3>
      <p>{t("landing.check.body")}</p>
      <a href={url("guides/testing-dialogue")}>{t("landing.check.link")}</a>
    </div>
    <div>
      <h3>{t("landing.integrate.title")}</h3>
      <p>{t("landing.integrate.body")}</p>
      <a href={url("adapters")}>{t("landing.integrate.link")}</a>
    </div>
  </div>
</section>

<section class="landing-copy" aria-labelledby="localisation-heading">
  <h2 id="localisation-heading">{t("landing.localisation.title")}</h2>
  <p>{t("landing.localisation.body1")}</p>
  <p>{t("landing.localisation.body2")}</p>
  <a href={url("guides/localisation")}>{t("landing.localisation.link")}</a>
</section>

<section class="landing-copy" aria-labelledby="fit-heading">
  <h2 id="fit-heading">{t("landing.fit.title")}</h2>
  <p>{t("landing.fit.body1")}</p>
  <p>{t("landing.fit.body2")}</p>
  <p>{t("landing.fit.body3")}</p>
  <a href={url("guides/alternatives")}>{t("landing.fit.link")}</a>
</section>

<nav class="landing-end" aria-label={t("landing.navigation.label")}>
  <a href={url("getting-started")}>{t("landing.navigation.manual")}</a>
  <a href={url("reference")}>{t("landing.navigation.reference")}</a>
  <a href={url("migration")}>{t("landing.navigation.migration")}</a>
  <a href={url("guides/distribution")}>{t("landing.navigation.packages")}</a>
  <a href="https://github.com/plethu/recite">{t("landing.navigation.source")}</a>
</nav>

<p class="landing-licence">{t("landing.licence")}</p>
