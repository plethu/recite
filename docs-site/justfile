set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set default-list

# Install the pinned build runtime and frozen workspace packages.
setup:
    mise install node pnpm
    ../scripts/install-js-dependencies.sh ..

# Run the site with hot reload.
dev *args: wasm
    pnpm dev --host 127.0.0.1 "$@"

# Check Astro components, browser/worker types and authored CSS.
check: wasm
    pnpm check
    pnpm test:content

# Build the static site.
build: wasm
    pnpm build

# Run the full documentation gate, including built links.
verify:
    ../scripts/check-docs.sh

# Serve the existing static build locally.
preview *args:
    pnpm preview "$@"

# Format the site source.
fmt *args:
    cd .. && mise -E quality exec -- dprint fmt docs-site "$@"

# Test the built site in Chromium, Firefox, and WebKit through Compose.
test-browser *args:
    ./check-browser.sh "$@"

# Generate native browser bindings for the real compiler/runtime host.
wasm:
    mise -E site install rust github:wasm-bindgen/wasm-bindgen
    cd .. && mise -E site exec -- cargo rustc --locked -p recite-playground --target wasm32-unknown-unknown --release -- -C link-arg=--max-memory=67108864
    cd .. && mise -E site exec -- wasm-bindgen target/wasm32-unknown-unknown/release/recite_playground.wasm --target web --out-dir docs-site/src/client/generated
