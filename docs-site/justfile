set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set default-list

# Install the native generator and exact unmodified theme revision.
setup:
    mise -E site install hugo rust github:wasm-bindgen/wasm-bindgen
    mise -E site exec hugo -- git -C .. submodule update --init --depth 1 -- docs-site/themes/hugo-book

# Run the site with hot reload.
dev *args: wasm
    mise -E site exec hugo -- hugo server --bind 127.0.0.1 "$@"

# Check browser-test types and authored CSS.
check: wasm
    pnpm check

# Build the static site.
build: wasm
    mise -E site exec hugo -- hugo --minify --panicOnWarning --cleanDestinationDir --destination dist

# Run the full documentation gate, including built links.
verify:
    ../scripts/check-docs.sh

# Serve the production build locally.
preview *args: wasm
    mise -E site exec hugo -- hugo server --bind 127.0.0.1 --disableLiveReload --disableFastRender "$@"

# Format the site source.
fmt *args:
    cd .. && mise -E quality exec -- dprint fmt docs-site "$@"

# Test the production site in Chromium, Firefox, and WebKit through Compose.
test-browser *args:
    ./check-browser.sh "$@"

# Generate native browser bindings for the real compiler/runtime host.
wasm:
    mise -E site install rust github:wasm-bindgen/wasm-bindgen
    cd .. && mise -E site exec -- cargo rustc --locked -p recite-playground --target wasm32-unknown-unknown --release -- -C link-arg=--max-memory=67108864
    cd .. && mise -E site exec -- wasm-bindgen target/wasm32-unknown-unknown/release/recite_playground.wasm --target web --out-dir docs-site/assets/playground/generated
