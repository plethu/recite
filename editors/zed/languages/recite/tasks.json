[
  {
    "label": "Recite: validate current file",
    "command": "recite",
    "args": ["validate", "--output-format", "structured", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current"
  },
  {
    "label": "Recite: extract current file",
    "command": "recite",
    "args": ["extract", "--output-format", "structured", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current"
  },
  {
    "label": "Recite: compile current file",
    "command": "recite",
    "args": [
      "compile",
      "--output",
      "$ZED_DIRNAME/$ZED_STEM.recitec",
      "--output-format",
      "structured",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current"
  },
  {
    "label": "Recite: watch worktree",
    "command": "recite",
    "args": ["watch", "--output-format", "structured", "$ZED_WORKTREE_ROOT"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "save": "current"
  }
]
