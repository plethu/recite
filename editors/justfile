set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set default-list
set working-directory := '..'

# Zed extension quality and test commands.
mod zed 'zed/justfile'

# Run an installed Neovim, VS Code, or Zed host check.
host client *args:
    case "$1" in neovim|vscode|zed) scripts/check-"$1"-host.sh "${@:2}" ;; *) echo 'Expected neovim, vscode, or zed' >&2; exit 2 ;; esac
