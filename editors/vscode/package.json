{
  "name": "recite-vscode",
  "displayName": "%lsp-client-display-name%",
  "version": "0.1.0",
  "description": "%lsp-client-description%",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "recite",
    "dialogue",
    "language-server",
    "lsp"
  ],
  "homepage": "https://github.com/plethu/recite",
  "bugs": {
    "url": "https://github.com/plethu/recite/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/plethu/recite.git",
    "directory": "editors/vscode"
  },
  "license": "MIT OR Apache-2.0",
  "publisher": "plethu",
  "type": "module",
  "main": "./dist/extension.cjs",
  "files": [
    "dist/**",
    "language-configuration.json",
    "syntaxes/**",
    "package.json",
    "package.nls.json",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "messages:update": "bun scripts/message-projections.mjs --update",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build && bun scripts/check-package.mjs && bun scripts/check-grammar.mjs && bun run --cwd ../.. js:test editors/vscode/test",
    "package": "bun scripts/package.mjs",
    "package:check": "bun scripts/package.mjs --check"
  },
  "contributes": {
    "languages": [
      {
        "id": "recite",
        "aliases": [
          "Recite",
          "recite"
        ],
        "extensions": [
          ".recite"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "recite",
        "scopeName": "source.recite",
        "path": "./syntaxes/recite.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "%lsp-client-configuration-title%",
      "properties": {
        "recite.lsp.path": {
          "type": "string",
          "default": "recite-lsp",
          "description": "%lsp-client-configuration-path-description%"
        },
        "recite.lsp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%lsp-client-configuration-args-description%"
        },
        "recite.lsp.projectRoot": {
          "type": "string",
          "default": "",
          "description": "%lsp-client-configuration-project-root-description%"
        },
        "recite.cli.path": {
          "type": "string",
          "default": "recite",
          "description": "%vscode-command-cli-path-description%"
        }
      }
    },
    "commands": [
      {
        "command": "recite.validate",
        "title": "%vscode-command-validate-title%"
      },
      {
        "command": "recite.compile",
        "title": "%vscode-command-compile-title%"
      },
      {
        "command": "recite.extract",
        "title": "%vscode-command-extract-title%"
      },
      {
        "command": "recite.watch.start",
        "title": "%vscode-command-watch-start-title%"
      },
      {
        "command": "recite.watch.stop",
        "title": "%vscode-command-watch-stop-title%"
      },
      {
        "command": "recite.run",
        "title": "%vscode-command-run-title%"
      },
      {
        "command": "recite.trace",
        "title": "%vscode-command-trace-title%"
      },
      {
        "command": "recite.renameBlock",
        "title": "%vscode-command-rename-command-title%"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:recite",
    "onCommand:recite.validate",
    "onCommand:recite.compile",
    "onCommand:recite.extract",
    "onCommand:recite.watch.start",
    "onCommand:recite.watch.stop",
    "onCommand:recite.run",
    "onCommand:recite.trace",
    "onCommand:recite.renameBlock"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/vscode": "1.89.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vscode/test-electron": "3.1.0",
    "fflate": "0.8.2",
    "oxc-parser": "0.154.0",
    "tsdown": "0.23.1",
    "valibot": "1.5.0",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.2.0"
  },
  "engines": {
    "vscode": "^1.89.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%lsp-client-untrusted-workspaces-description%",
      "restrictedConfigurations": [
        "recite.lsp.path",
        "recite.lsp.args",
        "recite.lsp.projectRoot",
        "recite.cli.path"
      ]
    }
  }
}
