@@ -0,0 +1,63 @@
+mod measure;
+mod positions;
+use lsp_types::Position;
+use serde_json::json;
+fn main() {
+    let mut texts = vec![
+        String::new(),
+        "a\u{2028}b".into(),
+        "a\u{0085}b".into(),
+        "a\u{2029}b".into(),
+    ];
+    let alphabet = ["a", "α", "😀", "\r", "\n", "\r\n"];
+    for mut n in 0..1296 {
+        let mut text = String::new();
+        for _ in 0..4 {
+            text.push_str(alphabet[n % 6]);
+            n /= 6;
+        }
+        texts.push(text);
+    }
+    let mut mismatches = [0usize; 4];
+    let mut checked = 0;
+    let mut lf_mismatches = [0usize; 4];
+    let mut lf_examples = [None, None, None, None];
+    let mut examples = [None, None, None, None];
+    // Expected panics from crop's strict surrogate API are converted to rejection.
+    std::panic::set_hook(Box::new(|_| {}));
+    for text in &texts {
+        let index = line_index::LineIndex::new(text);
+        let rope = ropey::Rope::from_str(text);
+        let crop = crop::Rope::from(text.as_str());
+        for line in 0..8 {
+            for character in 0..12 {
+                let pos = Position::new(line, character);
+                let expected = positions::reference(text, pos);
+                let actual = [
+                    positions::indices(text, pos),
+                    positions::indexed(text, &index, pos),
+                    positions::rope(&rope, pos),
+                    positions::cropped(&crop, pos),
+                ];
+                for i in 0..4 {
+                    if actual[i] != expected {
+                        mismatches[i] += 1;
+                        if !text.replace("\r\n", "").contains("\r") {
+                            lf_mismatches[i] += 1;
+                            lf_examples[i].get_or_insert(json!({"text":text,"line":line,"character":character,"expected":expected,"actual":actual[i]}));
+                        }
+                        examples[i].get_or_insert(json!({"text":text,"line":line,"character":character,"expected":expected,"actual":actual[i]}));
+                    }
+                }
+                checked += 1;
+            }
+        }
+    }
+    println!(
+        "{}",
+        json!({"positions":checked,"texts":texts.len(),"candidates":["str_indices","line-index","ropey","crop"],"mismatches":mismatches,"first_mismatches":examples,"lf_crlf_mismatches":lf_mismatches,"lf_first_mismatches":lf_examples})
+    );
+    assert_eq!(mismatches[0], 0);
+    assert_eq!(mismatches[2], 0);
+    measure::run();
+}
