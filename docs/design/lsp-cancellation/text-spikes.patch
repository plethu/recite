@@ -0,0 +1,101 @@
+use line_index::{LineCol, LineIndex, WideEncoding, WideLineCol};
+use lsp_types::Position;
+
+pub fn reference(text: &str, position: Position) -> Option<usize> {
+    let mut start = 0;
+    let bytes = text.as_bytes();
+    for _ in 0..position.line {
+        start += text[start..].find(['\r', '\n'])?;
+        if bytes[start] == b'\r' && bytes.get(start + 1) == Some(&b'\n') {
+            start += 1;
+        }
+        start += 1;
+    }
+    let mut units = 0;
+    for (offset, ch) in text[start..].char_indices() {
+        if units == position.character || ch == '\r' || ch == '\n' {
+            return Some(start + offset);
+        }
+        units += ch.len_utf16() as u32;
+        if units > position.character {
+            return None;
+        }
+    }
+    Some(text.len())
+}
+
+pub fn indices(text: &str, position: Position) -> Option<usize> {
+    let start = str_indices::lines_crlf::to_byte_idx(text, position.line as usize);
+    if str_indices::lines_crlf::from_byte_idx(text, start) != position.line as usize {
+        return None;
+    }
+    let line = &text[start..];
+    let line = &line[..line.find(['\r', '\n']).unwrap_or(line.len())];
+    let offset = str_indices::utf16::to_byte_idx(line, position.character as usize);
+    if offset < line.len()
+        && str_indices::utf16::from_byte_idx(line, offset) != position.character as usize
+    {
+        return None;
+    }
+    Some(start + offset)
+}
+
+pub fn indexed(text: &str, index: &LineIndex, position: Position) -> Option<usize> {
+    let range = index.line(position.line)?;
+    let start = u32::from(range.start()) as usize;
+    let raw = &text[start..u32::from(range.end()) as usize];
+    let line = raw.trim_end_matches(['\r', '\n']);
+    let max = index
+        .to_wide(
+            WideEncoding::Utf16,
+            LineCol {
+                line: position.line,
+                col: line.len() as u32,
+            },
+        )?
+        .col;
+    let col = index.to_utf8(
+        WideEncoding::Utf16,
+        WideLineCol {
+            line: position.line,
+            col: position.character.min(max),
+        },
+    )?;
+    let offset = index.offset(col)?;
+    index.try_line_col(offset)?;
+    Some(u32::from(offset) as usize)
+}
+
+pub fn rope(rope: &ropey::Rope, position: Position) -> Option<usize> {
+    let line = rope.get_line(position.line as usize)?;
+    let mut end = line.len_chars();
+    while end > 0 && matches!(line.char(end - 1), '\r' | '\n') {
+        end -= 1;
+    }
+    let line = line.slice(..end);
+    let units = (position.character as usize).min(line.len_utf16_cu());
+    let scalar = line.utf16_cu_to_char(units);
+    if line.char_to_utf16_cu(scalar) != units {
+        return None;
+    }
+    Some(rope.line_to_byte(position.line as usize) + line.char_to_byte(scalar))
+}
+
+pub fn cropped(rope: &crop::Rope, position: Position) -> Option<usize> {
+    // crop counts LF lines and omits the final empty line. The LSP does not.
+    if position.line as usize == rope.line_len()
+        && (rope.is_empty() || rope.bytes().last() == Some(b'\n'))
+    {
+        return Some(rope.byte_len());
+    }
+    if position.line as usize >= rope.line_len() {
+        return None;
+    }
+    let line = rope.line(position.line as usize);
+    let units = (position.character as usize).min(line.utf16_len());
+    let offset = std::panic::catch_unwind(|| line.byte_of_utf16_code_unit(units)).ok()?;
+    if line.utf16_code_unit_of_byte(offset) != units {
+        return None;
+    }
+    Some(rope.byte_of_line(position.line as usize) + offset)
+}
