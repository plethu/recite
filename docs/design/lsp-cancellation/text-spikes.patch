diff --git a/lspf/src/main.rs b/lspf/src/main.rs
new file mode 100644
--- /dev/null
+++ b/lspf/src/main.rs
@@ -0,0 +1,281 @@
+use bytes::Bytes;
+use lspf::{
+    CancellationToken, Document, LspError, RawMessage, RequestId, Server, ServerContext,
+    testing::ServerJourney,
+    types::{
+        DidChangeTextDocumentParams, DidOpenTextDocumentParams, TextDocumentSyncKind,
+        TextDocumentSyncOptions,
+        notification::{DidChangeTextDocument, DidOpenTextDocument},
+        request::Request,
+    },
+};
+use serde_json::{Value, json};
+use std::{
+    borrow::Cow,
+    sync::atomic::{AtomicBool, Ordering},
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+#[derive(Default)]
+struct State {
+    retained: Mutex<Option<Document>>,
+    hold: AtomicBool,
+    started: tokio::sync::Notify,
+    release: tokio::sync::Notify,
+    events: Mutex<Vec<Option<i32>>>,
+}
+struct Probe;
+impl Request for Probe {
+    type Params = Value;
+    type Result = Value;
+    const METHOD: &'static str = "probe/document";
+}
+async fn probe(
+    state: Arc<State>,
+    ctx: ServerContext,
+    params: Value,
+    ct: CancellationToken,
+) -> Result<Value, LspError> {
+    if params["hold"] == true {
+        state.started.notify_one();
+        ct.cancelled().await;
+        return Err(LspError::RequestCancelled);
+    }
+    let uri = params["uri"].as_str().unwrap().parse().unwrap();
+    let doc = ctx.documents().get(&uri).unwrap();
+    let retained = state.retained.lock().unwrap();
+    Ok(
+        json!({"text":doc.text(None),"version":doc.version(),"retained":retained.as_ref().map(|d|d.text(None).into_owned())}),
+    )
+}
+async fn opened(state: Arc<State>, ctx: ServerContext, params: DidOpenTextDocumentParams) {
+    let mut retained = state.retained.lock().unwrap();
+    if retained.is_none() {
+        *retained = ctx.documents().get(&params.text_document.uri);
+    }
+}
+async fn changed(state: Arc<State>, _: ServerContext, params: DidChangeTextDocumentParams) {
+    state
+        .events
+        .lock()
+        .unwrap()
+        .push(Some(params.text_document.version));
+    if state.hold.swap(false, Ordering::SeqCst) {
+        state.started.notify_one();
+        state.release.notified().await;
+    }
+}
+async fn controls(uri: &str) {
+    let state = Arc::new(State::default());
+    let server = Server::builder(state.clone())
+        .concurrency_limit(1)
+        .text_document_sync(TextDocumentSyncOptions {
+            open_close: Some(true),
+            change: Some(TextDocumentSyncKind::Incremental),
+            ..Default::default()
+        })
+        .request::<Probe, _, _>(|s: Arc<Arc<State>>, ctx, p, ct| probe((*s).clone(), ctx, p, ct))
+        .notification::<DidOpenTextDocument, _, _>(|s: Arc<Arc<State>>, ctx, p| {
+            opened((*s).clone(), ctx, p)
+        })
+        .notification::<DidChangeTextDocument, _, _>(|s: Arc<Arc<State>>, ctx, p| {
+            changed((*s).clone(), ctx, p)
+        })
+        .build()
+        .unwrap();
+    let mut journey = ServerJourney::start(server).await.unwrap();
+    journey
+        .peer()
+        .send(message(
+            "textDocument/didOpen",
+            json!({"textDocument":{"uri":uri,"languageId":"recite","version":1,"text":"start"}}),
+            None,
+        ))
+        .unwrap();
+    state.hold.store(true, Ordering::SeqCst);
+    journey
+        .peer()
+        .send(message(
+            "textDocument/didChange",
+            json!({"textDocument":{"uri":uri,"version":2},"contentChanges":[{"text":"second"}]}),
+            None,
+        ))
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(2), state.started.notified())
+        .await
+        .unwrap();
+    journey
+        .peer()
+        .send(message(
+            "textDocument/didChange",
+            json!({"textDocument":{"uri":uri,"version":3},"contentChanges":[{"text":"third"}]}),
+            None,
+        ))
+        .unwrap();
+    journey
+        .peer()
+        .send(message("probe/document", json!({"uri":uri}), Some(10)))
+        .unwrap();
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), journey.peer().recv())
+            .await
+            .is_err()
+    );
+    assert_eq!(*state.events.lock().unwrap(), [Some(2)]);
+    state.release.notify_one();
+    let response = journey.peer().recv().await.unwrap();
+    if let RawMessage::Response {
+        result: Ok(bytes), ..
+    } = response
+    {
+        assert_eq!(
+            serde_json::from_slice::<Value>(&bytes).unwrap()["text"],
+            "third"
+        );
+    }
+    assert_eq!(*state.events.lock().unwrap(), [Some(2), Some(3)]);
+    journey
+        .peer()
+        .send(message("probe/document", json!({"hold":true}), Some(11)))
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(2), state.started.notified())
+        .await
+        .unwrap();
+    journey
+        .peer()
+        .send(message("$/cancelRequest", json!({"id":11}), None))
+        .unwrap();
+    let response = tokio::time::timeout(Duration::from_secs(2), journey.peer().recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(matches!(
+        response,
+        RawMessage::Response { result: Err(_), .. }
+    ));
+    journey.finish().await.unwrap();
+    println!(
+        "{}",
+        json!({"serial_mutation_hook":true,"saturated_cancellation":true})
+    );
+}
+fn message(method: &'static str, params: Value, id: Option<i32>) -> RawMessage {
+    let params = Bytes::from(params.to_string());
+    match id {
+        Some(id) => RawMessage::Request {
+            id: RequestId::Number(id),
+            method: Cow::Borrowed(method),
+            params,
+        },
+        None => RawMessage::Notification {
+            method: Cow::Borrowed(method),
+            params,
+        },
+    }
+}
+#[tokio::main(flavor = "current_thread")]
+async fn main() {
+    let uri = "file:///probe.recite";
+    let original = "a😀b\r\nsecond";
+    let cases = [
+        (
+            "valid ranged",
+            2,
+            json!([{"range":{"start":{"line":0,"character":1},"end":{"line":0,"character":3}},"rangeLength":2,"text":"X"}]),
+        ),
+        (
+            "atomic reversed second",
+            2,
+            json!([{"text":"changed"},{"range":{"start":{"line":0,"character":3},"end":{"line":0,"character":1}},"text":"X"}]),
+        ),
+        (
+            "surrogate interior",
+            2,
+            json!([{"range":{"start":{"line":0,"character":2},"end":{"line":0,"character":3}},"text":"X"}]),
+        ),
+        ("stale version", 0, json!([{"text":"stale"}])),
+        ("equal version", 1, json!([{"text":"equal"}])),
+        (
+            "wrong rangeLength",
+            2,
+            json!([{"range":{"start":{"line":0,"character":1},"end":{"line":0,"character":3}},"rangeLength":1,"text":"X"}]),
+        ),
+        (
+            "malformed raw range",
+            2,
+            json!([{"range":{"start":{"line":0,"character":0}},"text":"replacement"}]),
+        ),
+        (
+            "overlong column",
+            2,
+            json!([{"range":{"start":{"line":0,"character":99},"end":{"line":0,"character":99}},"text":"X"}]),
+        ),
+    ];
+    for (name, version, changes) in cases {
+        let server = Server::builder(State::default())
+            .text_document_sync(TextDocumentSyncOptions {
+                open_close: Some(true),
+                change: Some(TextDocumentSyncKind::Incremental),
+                ..Default::default()
+            })
+            .request::<Probe, _, _>(probe)
+            .notification::<DidOpenTextDocument, _, _>(opened)
+            .build()
+            .unwrap();
+        let mut journey = ServerJourney::start(server).await.unwrap();
+        journey.peer().send(message("textDocument/didOpen",json!({"textDocument":{"uri":uri,"languageId":"recite","version":1,"text":original}}),None)).unwrap();
+        journey
+            .peer()
+            .send(message(
+                "textDocument/didChange",
+                json!({"textDocument":{"uri":uri,"version":version},"contentChanges":changes}),
+                None,
+            ))
+            .unwrap();
+        journey
+            .peer()
+            .send(message("probe/document", json!({"uri":uri}), Some(10)))
+            .unwrap();
+        let result = tokio::time::timeout(Duration::from_secs(2), journey.peer().recv())
+            .await
+            .unwrap()
+            .unwrap();
+        if let RawMessage::Response {
+            result: Ok(bytes), ..
+        } = result
+        {
+            let result: Value = serde_json::from_slice(&bytes).unwrap();
+            assert_eq!(result["retained"], original);
+            println!("{}", json!({"case":name,"result":result}));
+            match name {
+                "valid ranged" => assert_eq!(result["text"], "aXb\r\nsecond"),
+                "atomic reversed second" | "surrogate interior" => {
+                    assert_eq!(result["text"], original)
+                }
+                _ => {}
+            }
+        } else {
+            panic!("unexpected response {result:?}");
+        }
+        journey.peer().send(message("textDocument/didOpen",json!({"textDocument":{"uri":uri,"languageId":"recite","version":7,"text":"duplicate"}}),None)).unwrap();
+        journey
+            .peer()
+            .send(message("probe/document", json!({"uri":uri}), Some(11)))
+            .unwrap();
+        let result = journey.peer().recv().await.unwrap();
+        if let RawMessage::Response {
+            result: Ok(bytes), ..
+        } = result
+        {
+            let result: Value = serde_json::from_slice(&bytes).unwrap();
+            assert_eq!(result["text"], "duplicate");
+            assert_eq!(result["retained"], original);
+        }
+        journey.finish().await.unwrap();
+    }
+    controls(uri).await;
+    println!(
+        "{}",
+        json!({"duplicate_open":"overwrites","retained_snapshot":"unchanged","version":"1.0.3"})
+    );
+}
