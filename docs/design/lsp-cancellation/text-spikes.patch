new file mode 100644
--- /dev/null
+++ b/text/src/measure.rs
@@ -0,0 +1,117 @@
+use crate::positions;
+use lsp_types::Position;
+use serde_json::json;
+use std::{hint::black_box, time::Instant};
+fn timed(mut f: impl FnMut(), operations: usize) -> f64 {
+    let start = Instant::now();
+    for _ in 0..operations {
+        f();
+    }
+    start.elapsed().as_secs_f64() * 1e6 / operations as f64
+}
+pub fn run() {
+    for lines in [100, 2_000, 20_000] {
+        let text = "alpha 😀 dialogue content 0123456789\n".repeat(lines);
+        for fraction in [0, 1, 2] {
+            let position = Position::new(((lines - 2) * fraction / 2) as u32, 4);
+            let start = positions::reference(&text, position).unwrap();
+            let index = line_index::LineIndex::new(&text);
+            let rope = ropey::Rope::from_str(&text);
+            let crop = crop::Rope::from(text.as_str());
+            assert_eq!(positions::indexed(&text, &index, position), Some(start));
+            assert_eq!(positions::rope(&rope, position), Some(start));
+            assert_eq!(positions::cropped(&crop, position), Some(start));
+            let mut samples = Vec::new();
+            for pair in 0..7 {
+                let order: Vec<usize> = if pair % 2 == 0 {
+                    (0..10).collect()
+                } else {
+                    (0..10).rev().collect()
+                };
+                let mut us = vec![0.0; 10];
+                for side in order {
+                    us[side] = match side {
+                        0 => timed(
+                            || {
+                                black_box(positions::reference(black_box(&text), position));
+                            },
+                            100,
+                        ),
+                        1 => timed(
+                            || {
+                                black_box(positions::indices(black_box(&text), position));
+                            },
+                            100,
+                        ),
+                        2 => timed(
+                            || {
+                                black_box(positions::indexed(&text, black_box(&index), position));
+                            },
+                            100,
+                        ),
+                        3 => timed(
+                            || {
+                                black_box(positions::rope(black_box(&rope), position));
+                            },
+                            100,
+                        ),
+                        4 => timed(
+                            || {
+                                black_box(positions::cropped(black_box(&crop), position));
+                            },
+                            100,
+                        ),
+                        5 => timed(
+                            || {
+                                black_box(line_index::LineIndex::new(black_box(&text)));
+                            },
+                            21,
+                        ),
+                        // Each edit stages a transaction and emits the contiguous snapshot our parser consumes.
+                        6 => timed(
+                            || {
+                                let mut next = text.clone();
+                                let at = positions::reference(&next, position).unwrap();
+                                next.replace_range(at..at + 1, "b");
+                                black_box(next);
+                            },
+                            21,
+                        ),
+                        7 => timed(
+                            || {
+                                let mut next = rope.clone();
+                                let at =
+                                    next.byte_to_char(positions::rope(&next, position).unwrap());
+                                next.remove(at..at + 1);
+                                next.insert(at, "b");
+                                black_box(next.to_string());
+                            },
+                            21,
+                        ),
+                        8 => timed(
+                            || {
+                                let mut next = crop.clone();
+                                let at = positions::cropped(&next, position).unwrap();
+                                next.replace(at..at + 1, "b");
+                                black_box(next.to_string());
+                            },
+                            21,
+                        ),
+                        9 => timed(
+                            || {
+                                black_box(rope.clone());
+                            },
+                            100,
+                        ),
+                        _ => unreachable!(),
+                    };
+                }
+                samples.push(us);
+            }
+            println!(
+                "{}",
+                json!({"bytes":text.len(),"lines":lines,"line":position.line,"unit":"microseconds/op","order":"alternating forward/reverse,7pairs","columns":["String_position","str_indices_position","line_index_cached_position","ropey_cached_position","crop_cached_position","line_index_build","String_transaction_snapshot","ropey_transaction_snapshot","crop_transaction_snapshot","ropey_clone_only"],"samples":samples})
+            );
+        }
+    }
+}
