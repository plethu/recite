+fn byte_offset(text: &str, position: lsp_types::Position) -> Option<usize> {
+    let mut start = 0;
+    let bytes = text.as_bytes();
+    for _ in 0..position.line {
+        while start < bytes.len() && bytes[start] != b'\r' && bytes[start] != b'\n' { start += 1; }
+        if start == bytes.len() { return None; }
+        if bytes[start] == b'\r' && bytes.get(start + 1) == Some(&b'\n') { start += 1; }
+        start += 1;
+    }
+    let mut units = 0;
+    for (offset, ch) in text[start..].char_indices() {
+        if units == position.character { return Some(start + offset); }
+        if ch == '\r' || ch == '\n' { return None; }
+        units += u32::try_from(ch.len_utf16()).ok()?;
+        if units > position.character { return None; }
+    }
+    (units == position.character).then_some(text.len())
