+// Disposable experiment: normalize ranges before the full-text coalescing queue.
+fn apply_changes(original: &str, changes: &[lsp_types::TextDocumentContentChangeEvent]) -> Option<String> {
+    if changes.is_empty() { return None; }
+    let mut text = original.to_owned();
+    for change in changes {
+        if let Some(range) = change.range {
+            let start = byte_offset(&text, range.start)?;
+            let end = byte_offset(&text, range.end)?;
+            if start > end { return None; }
+            if let Some(length) = change.range_length {
+                if usize::try_from(length).ok()? != text[start..end].encode_utf16().count() { return None; }
+            }
+            text.replace_range(start..end, &change.text);
+        } else {
+            if change.range_length.is_some() { return None; }
+            text.clone_from(&change.text);
+        }
+    }
+    Some(text)
