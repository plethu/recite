diff --git 1/crates/recite-lsp/src/workspace/partition_paths.rs 2/crates/recite-lsp/src/workspace/partition_paths.rs
new file mode 100644
index 00000000..122ac392
--- /dev/null
+++ 2/crates/recite-lsp/src/workspace/partition_paths.rs
@@ -0,0 +1,53 @@
+//! Filesystem identities resolved once for one partition rebuild, never retained
+//! across edits or discovery refreshes.
+use std::{collections::BTreeMap, path::Path};
+
+use super::project_index::{SavedDocument, SavedProjectIndex};
+use crate::{documents::OpenDocumentStore, paths::stable_path_identity};
+
+pub(super) struct PartitionPaths<'a> {
+    saved: BTreeMap<String, Vec<&'a SavedDocument>>,
+    open: BTreeMap<&'a Path, OpenPath>,
+}
+
+struct OpenPath {
+    partition: String,
+    target: String,
+}
+
+impl<'a> PartitionPaths<'a> {
+    pub(super) fn new(saved: &'a SavedProjectIndex, documents: &'a OpenDocumentStore) -> Self {
+        let mut result = Self {
+            saved: BTreeMap::new(),
+            open: BTreeMap::new(),
+        };
+        for document in saved.documents.values() {
+            if let Some(partition) = saved.partition_for_path(&document.identity.canonical_path) {
+                result.saved.entry(partition).or_default().push(document);
+            }
+        }
+        for document in documents.documents() {
+            if let Some(path) = document.identity().saved_path.as_deref() {
+                result.open.entry(path).or_insert_with(|| OpenPath {
+                    partition: saved
+                        .partition_for_open_path(path)
+                        .unwrap_or_else(|| "standalone".to_owned()),
+                    target: stable_path_identity(path),
+                });
+            }
+        }
+        result
+    }
+
+    pub(super) fn saved(&self, partition: &str) -> &[&'a SavedDocument] {
+        self.saved.get(partition).map_or(&[], Vec::as_slice)
+    }
+
+    pub(super) fn partition(&self, path: &Path) -> Option<&str> {
+        self.open.get(path).map(|entry| entry.partition.as_str())
+    }
+
+    pub(super) fn target(&self, path: &Path) -> Option<&str> {
+        self.open.get(path).map(|entry| entry.target.as_str())
+    }
+}
