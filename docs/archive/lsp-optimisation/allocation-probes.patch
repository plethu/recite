+"""Alternate uninstrumented binaries; measure process CPU only around work."""
+import argparse,importlib.util,json,statistics
+from pathlib import Path
+parser=argparse.ArgumentParser()
+parser.add_argument('--probe',type=Path,required=True)
+parser.add_argument('--control',type=Path,required=True)
+parser.add_argument('--candidate',type=Path,required=True)
+parser.add_argument('--project',type=Path,required=True)
+parser.add_argument('--output',type=Path,required=True)
+args=parser.parse_args()
+spec=importlib.util.spec_from_file_location('final_probes',args.probe)
+probes=importlib.util.module_from_spec(spec); spec.loader.exec_module(probes)
+output=args.output
+output.parent.mkdir(parents=True,exist_ok=True)
+environment=probes.environment()
+report={'environment_before':environment,'pairs':[],'status':'incomplete'}
+for index in range(3):
+    pair={}; report['pairs'].append(pair)
+    order=['control','candidate'] if index%2==0 else ['candidate','control']
+    for side in order:
+        binary=args.control if side=='control' else args.candidate
+        pair[side]={'binary_sha256':probes.hashlib.sha256(binary.read_bytes()).hexdigest(),'runs':[]}
+        for case in probes.CASES:
+            row=probes.run(binary.resolve(),args.project.resolve(),case,96,'control',output.parent/'cpu-pairs')
+            pair[side]['runs'].append(row)
+            output.write_text(json.dumps(report,indent=2)+'\n')
+            assert probes.environment()==environment, 'execution profile changed'
+        print('pair',index+1,side,'complete',flush=True)
+    for a,b in zip(pair['control']['runs'],pair['candidate']['runs']):
+        assert a['case']==b['case'] and a['fingerprints']==b['fingerprints']
+report['status']='pass'; report['environment_after']=probes.environment()
+output.write_text(json.dumps(report,indent=2)+'\n')
+for case_index,case in enumerate(probes.CASES):
+    cpu_ratios=[]; wall_ratios=[]
+    for pair in report['pairs']:
+        a=pair['control']['runs'][case_index]; b=pair['candidate']['runs'][case_index]
+        cpu_ratios.append(b['cpu_ms']/a['cpu_ms'])
+        wall_ratios.append(statistics.median(b['timings_ms'])/statistics.median(a['timings_ms']))
+    print(case,'CPU ratios',cpu_ratios,'wall ratios',wall_ratios)
