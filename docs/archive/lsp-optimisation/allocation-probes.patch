+"""Resolve small-workload variance without changing acceptance budgets."""
+import argparse,hashlib,importlib.util,json,statistics,sys,tempfile,time
+from pathlib import Path
+sys.path.insert(0,str(Path('scripts').resolve()))
+from lsp_measurement import change_event,environment
+spec=importlib.util.spec_from_file_location('latency','scripts/measure-lsp-latency.py')
+probe=importlib.util.module_from_spec(spec);spec.loader.exec_module(probe)
+parser=argparse.ArgumentParser()
+for name in ['control','candidate','project','output']:parser.add_argument('--'+name,type=Path,required=True)
+args=parser.parse_args(); root=args.project.resolve()
+source=sorted((root/'src').glob('*.recite'))[0];text=source.read_text();uri=source.as_uri()
+declaration=probe.position(text,r'^:: (block_00001)\b')
+params={'textDocument':{'uri':uri},'range':{'start':declaration,'end':declaration},
+        'context':{'diagnostics':[],'only':['source.fixAll']}}
+report={'environment':environment(),'pairs':[],'samples':{'code_action':1024,'comment':96},'warmups':16}
+for pair_index in range(3):
+    pair={};report['pairs'].append(pair)
+    for side in (['control','candidate'] if pair_index%2==0 else ['candidate','control']):
+        binary=getattr(args,side).resolve();pair[side]={}
+        for case in ['code_action','comment']:
+            with tempfile.TemporaryDirectory(prefix='recite-spot-') as config:
+                client=probe.Client(binary,Path(config));values=[];hashes=[];previous=text
+                try:
+                    client.request('initialize',{'processId':None,'rootUri':root.as_uri(),'capabilities':{}})
+                    client.send('initialized',{})
+                    client.send('textDocument/didOpen',{'textDocument':{'uri':uri,'languageId':'recite','version':1,'text':text}})
+                    client.diagnostics(uri,1)
+                    for index in range(report['samples'][case]+16):
+                        if case=='code_action':
+                            ms,reply=client.request('textDocument/codeAction',params)
+                            assert 'result' in reply,reply; result=reply['result']
+                        else:
+                            version=index+2;overlay=text+f'\n# spot edit {version}\n'
+                            event=change_event(previous,overlay,True);previous=overlay
+                            _,start=client.send('textDocument/didChange',{'textDocument':{'uri':uri,'version':version},'contentChanges':[event]})
+                            received=client.diagnostics(uri,version);ms=(received-start)/1e6
+                            result=next(m['params']['diagnostics'] for m in reversed(client.notifications)
+                                        if m.get('method')=='textDocument/publishDiagnostics' and m['params'].get('uri')==uri and m['params'].get('version')==version)
+                            assert not result
+                        if index>=16:
+                            values.append(ms);hashes.append(hashlib.sha256(json.dumps(result,sort_keys=True).encode()).hexdigest())
+                    pair[side][case]={'ms':values,'fingerprints':hashes,'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest()}
+                finally:client.close()
+        args.output.write_text(json.dumps(report,indent=2)+'\n')
+        assert environment()==report['environment']
+        print(pair_index+1,side,'complete',flush=True)
+    for case in report['samples']:
+        assert pair['control'][case]['fingerprints']==pair['candidate'][case]['fingerprints']
+report['status']='pass';args.output.write_text(json.dumps(report,indent=2)+'\n')
+for case in report['samples']:
+    print(case,[round(statistics.median(p['candidate'][case]['ms'])/statistics.median(p['control'][case]['ms']),3) for p in report['pairs']])
