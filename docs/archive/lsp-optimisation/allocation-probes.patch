+"""Disposable final-LSP CPU/allocation probes; run from the Recite root."""
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import statistics
+import subprocess
+import sys
+import tempfile
+import time
+
+sys.path.insert(0, str(Path('scripts').resolve()))
+from lsp_measurement import change_event, environment
+spec = importlib.util.spec_from_file_location('probe', 'scripts/measure-lsp-latency.py')
+probe = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(probe)
+CASES = ['comment', 'line_insert', 'block_topology', 'recovery', 'diagnostics', 'completion', 'rename']
+
+
+def fingerprint(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
+
+
+def marker(paths, phase):
+    paths['marker'].write_text(phase)
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline:
+        if paths['metrics'].exists():
+            lines = paths['metrics'].read_text().splitlines()
+            records = [json.loads(line) for line in lines]
+            found = [row for row in records if row['phase'] == phase]
+            if found:
+                return found[-1]
+        time.sleep(.02)
+    raise RuntimeError('heap marker timeout: ' + phase)
+
+
+def run(binary, root, case, samples, mode, output):
+    paths = {key: (output / f'{case}-{mode}-{key}.{suffix}').resolve()
+             for key, suffix in [('heap', 'json'), ('metrics', 'jsonl'), ('marker', 'txt')]}
+    for path in paths.values():
+        if path.exists(): path.unlink()
+    source = sorted((root / 'src').glob('*.recite'))[0]
+    original = source.read_text()
+    text = original
+    if case == 'rename':
+        text = re.sub(r'(-> )block_\d+\b', r'\g<1>block_00001', text)
+    uri = source.as_uri()
+    hashes = {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
+              for p in sorted(root.rglob('*')) if p.is_file()}
+    reference = probe.position(text, r'-> (block_\d+)', end=True)
+    declaration = probe.position(text, r'^:: (block_00001)\b')
+    at = lambda pos: {'textDocument': {'uri': uri}, 'position': pos}
+    profiler = None
+    heap_stats = []
+    cpu_before = cpu_after = None
+    with tempfile.TemporaryDirectory(prefix='recite-final-probe-') as config:
+        env = ({'RECITE_HEAP_OUTPUT': str(paths['heap']), 'RECITE_HEAP_MARKER': str(paths['marker']),
+                'RECITE_HEAP_METRICS': str(paths['metrics'])} if mode == 'heap' else {})
+        client = probe.Client(binary, Path(config), server_env=env)
+        try:
+            client.request('initialize', {'processId': None, 'rootUri': root.as_uri(), 'capabilities': {}})
+            client.send('initialized', {})
+            client.send('textDocument/didOpen', {'textDocument': {
+                'uri': uri, 'languageId': 'recite', 'version': 1, 'text': text}})
+            client.diagnostics(uri, 1)
+            time.sleep(.15)
+            if mode == 'heap': heap_stats.append(marker(paths, 'opened'))
+            if mode == 'cpu':
+                log = (output / f'{case}-perf.log').open('w')
+                profiler = subprocess.Popen(['perf', 'record', '-e', 'cycles:u', '-F', '997',
+                    '--call-graph', 'dwarf,16384', '-o', str(output / f'{case}.data'),
+                    '-p', str(client.process.pid)], stdout=subprocess.DEVNULL, stderr=log)
+                time.sleep(.15)
+                if profiler.poll() is not None: raise RuntimeError('perf attach failed')
+            if mode == 'control':
+                # Only uninstrumented runs use process CPU accounting.
+                import psutil
+                process = psutil.Process(client.process.pid)
+                cpu_before = sum(process.cpu_times()[:2])
+            timings, results = [], []
+            previous = text
+            for index in range(samples):
+                version = index + 2
+                started = time.perf_counter_ns()
+                if case in ['completion', 'rename']:
+                    params = at(reference) if case == 'completion' else {**at(declaration), 'newName': 'measured_block'}
+                    elapsed, reply = client.request('textDocument/' + case, params)
+                    assert 'error' not in reply, reply
+                    result = reply['result']
+                    assert result
+                    if case == 'rename':
+                        edits = result['documentChanges'][0]['edits']
+                        expected = len(list(re.finditer(r'(?:-> |:: )block_00001\b', text)))
+                        assert len(edits) == expected, (len(edits), expected)
+                else:
+                    if case == 'comment': overlay = text + f'\n# edit {version}\n'
+                    elif case == 'line_insert':
+                        overlay = re.sub(r'(?m)^([ \t]*)(line 00000 000 )',
+                            lambda m: m[0] + f'revision {version} ' + ('\n' + m[1] + 'New paragraph ') * (1 + index % 2), text, count=1)
+                    elif case == 'block_topology': overlay = text + f'\n:: measured_{version}\n-> END\n'
+                    elif case == 'recovery': overlay = text + (f'\nstray syntax {version}\n' if index % 2 else f'\n# recovered {version}\n')
+                    else:
+                        # Many real unknown destinations, each with a stable block name.
+                        overlay = text + ''.join(f'\n:: bad_{n}\n-> missing_{n}_{index % 2}\n' for n in range(100))
+                    assert overlay != text
+                    event = change_event(previous, overlay, True)
+                    previous = overlay
+                    _, started = client.send('textDocument/didChange', {
+                        'textDocument': {'uri': uri, 'version': version}, 'contentChanges': [event]})
+                    received = client.diagnostics(uri, version)
+                    elapsed = (received - started) / 1e6
+                    result = next(m['params']['diagnostics'] for m in reversed(client.notifications)
+                                  if m.get('method') == 'textDocument/publishDiagnostics'
+                                  and m['params'].get('uri') == uri and m['params'].get('version') == version)
+                    if case not in ['recovery', 'diagnostics']: assert not result, (case, result)
+                    if case == 'diagnostics': assert len(result) == 100, len(result)
+                timings.append(elapsed)
+                results.append(fingerprint(result))
+            if mode == 'control': cpu_after = sum(process.cpu_times()[:2])
+            if profiler:
+                profiler.send_signal(signal.SIGINT)
+                assert profiler.wait(timeout=15) in (0, -signal.SIGINT)
+                profiler = None
+                log.close()
+            if mode == 'heap':
+                time.sleep(.15)
+                heap_stats.append(marker(paths, 'after_work'))
+                client.send('textDocument/didChange', {'textDocument': {'uri': uri, 'version': samples + 3},
+                             'contentChanges': [{'text': original}]})
+                client.diagnostics(uri, samples + 3)
+                client.send('textDocument/didClose', {'textDocument': {'uri': uri}})
+                time.sleep(.3)
+                client.request('textDocument/definition', at(probe.position(original, r'-> (block_\d+)')))
+                heap_stats.append(marker(paths, 'restored_closed'))
+            client.close()
+        finally:
+            if profiler:
+                profiler.send_signal(signal.SIGINT)
+                profiler.wait(timeout=15)
+            if client.process.poll() is None: client.abort()
+    assert hashes == {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
+                       for p in sorted(root.rglob('*')) if p.is_file()}
+    return {'case': case, 'mode': mode, 'samples': samples, 'timings_ms': timings,
+            'fingerprints': results, 'heap': heap_stats,
+            'cpu_ms': (cpu_after - cpu_before) * 1000 if cpu_before is not None else None,
+            'source_bytes': len(original.encode()), 'fixture_hashes': hashes}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--binary', type=Path, required=True)
+    parser.add_argument('--root', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--mode', choices=['control', 'cpu', 'heap'], required=True)
+    parser.add_argument('--samples', type=int, required=True)
+    parser.add_argument('--case', choices=CASES, action='append')
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    report = {'revision': subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
+              'environment_before': environment(), 'binary_sha256': hashlib.sha256(args.binary.read_bytes()).hexdigest(),
+              'harness_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), 'runs': []}
+    for case in args.case or CASES:
+        row = run(args.binary.resolve(), args.root.resolve(), case, args.samples, args.mode, args.output)
+        report['runs'].append(row)
+        print(case, 'median_ms', round(statistics.median(row['timings_ms']), 3), 'heap', row['heap'], flush=True)
+        report['environment_after'] = environment()
+        (args.output / f'{args.mode}-results.json').write_text(json.dumps(report, indent=2) + '\n')
+
+if __name__ == '__main__': main()
