+// Disposable diagnostic instrumentation; never part of the production build.
+#[cfg(feature = "allocation-profile")]
+struct HeapProfile {
+    profiler: dhat::Profiler,
+    stop: std::sync::mpsc::Sender<()>,
+    monitor: Option<std::thread::JoinHandle<()>>,
+}
+
+#[cfg(feature = "allocation-profile")]
+impl HeapProfile {
+    fn start() -> Self {
+        let output = std::env::var_os("RECITE_HEAP_OUTPUT").expect("diagnostic output path");
+        let marker =
+            std::path::PathBuf::from(std::env::var_os("RECITE_HEAP_MARKER").expect("marker path"));
+        let metrics = std::env::var_os("RECITE_HEAP_METRICS").expect("metrics path");
+        let profiler = dhat::Profiler::builder().file_name(output).build();
+        let (stop, stopped) = std::sync::mpsc::channel();
+        let monitor = std::thread::spawn(move || {
+            use std::io::Write;
+            let mut output = std::fs::File::create(metrics).expect("metrics file");
+            let mut previous = String::new();
+            while stopped
+                .recv_timeout(std::time::Duration::from_millis(20))
+                .is_err()
+            {
+                let current = std::fs::read_to_string(&marker).unwrap_or_default();
+                if current.is_empty() || current == previous {
+                    continue;
+                }
+                previous = current;
+                let s = dhat::HeapStats::get();
+                writeln!(
+                    output,
+                    "{}",
+                    serde_json::json!({"phase": previous.trim(),
+                    "total_bytes": s.total_bytes, "allocations": s.total_blocks,
+                    "live_bytes": s.curr_bytes, "peak_live_bytes": s.max_bytes})
+                )
+                .expect("metrics write");
+                output.flush().expect("metrics flush");
+            }
+        });
+        Self {
+            profiler,
+            stop,
+            monitor: Some(monitor),
+        }
+    }
+}
+
+#[cfg(feature = "allocation-profile")]
+impl Drop for HeapProfile {
+    fn drop(&mut self) {
+        let _ = self.stop.send(());
+        self.monitor
+            .take()
+            .expect("monitor exists")
+            .join()
+            .expect("monitor stopped");
+        let _ = &self.profiler;
+    }
+}
