+use serde_json::{Value, json};
+use std::{
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt, BufReader},
+    sync::Notify,
+    time::timeout,
+};
+use tower_lsp_server::{
+    LanguageServer, LspService, Server,
+    gen_lsp_types::{InitializeParams, InitializeResult},
+    jsonrpc::Result,
+};
+
+pub(super) async fn send(w: &mut (impl AsyncWriteExt + Unpin), value: Value) {
+    let body = value.to_string();
+    w.write_all(format!("Content-Length: {}\r\n\r\n{body}", body.len()).as_bytes())
+        .await
+        .unwrap();
+    w.flush().await.unwrap();
+}
+pub(super) async fn receive(r: &mut BufReader<impl AsyncReadExt + Unpin>) -> Value {
+    let mut size = 0;
+    loop {
+        let mut line = String::new();
+        assert!(r.read_line(&mut line).await.unwrap() > 0);
+        if line == "\r\n" {
+            break;
+        }
+        if let Some(value) = line.strip_prefix("Content-Length:") {
+            size = value.trim().parse().unwrap();
+        }
+    }
+    let mut body = vec![0; size];
+    r.read_exact(&mut body).await.unwrap();
+    serde_json::from_slice(&body).unwrap()
+}
+#[derive(Debug, Clone)]
+pub(super) struct Backend {
+    pub(super) events: Arc<Mutex<Vec<&'static str>>>,
+    pub(super) release: Arc<Notify>,
+    pub(super) started: Arc<Notify>,
+}
+impl LanguageServer for Backend {
+    async fn initialize(&self, _: InitializeParams) -> Result<InitializeResult> {
+        Ok(InitializeResult::default())
+    }
+    async fn shutdown(&self) -> Result<()> {
+        Ok(())
+    }
+}
+impl Backend {
+    async fn first(&self) {
+        self.events.lock().unwrap().push("first started");
+        self.release.notified().await;
+        self.events.lock().unwrap().push("first finished");
+    }
+    async fn second(&self) {
+        self.events.lock().unwrap().push("second finished");
+    }
+    async fn slow(&self) -> Result<Value> {
+        self.started.notify_one();
+        futures::future::pending().await
+    }
+    pub(super) async fn answer(&self) -> Result<Value> {
+        Ok(json!("answer"))
+    }
+    pub(super) async fn barrier(&self) -> Result<Value> {
+        self.started.notify_one();
+        Ok(json!("barrier"))
+    }
+}
+
+async fn tower_probe(concurrency: usize) {
+    let backend = Backend {
+        events: Arc::default(),
+        release: Arc::default(),
+        started: Arc::default(),
+    };
+    let state = backend.clone();
+    let (service, socket) = LspService::build(|_| backend)
+        .custom_method("probe/first", Backend::first)
+        .custom_method("probe/second", Backend::second)
+        .custom_method("probe/slow", Backend::slow)
+        .custom_method("probe/barrier", Backend::barrier)
+        .finish();
+    let (client, server) = tokio::io::duplex(65536);
+    let (input, output) = tokio::io::split(server);
+    let task = tokio::spawn(
+        Server::new(input, output, socket)
+            .concurrency_level(concurrency)
+            .serve(service),
+    );
+    let (read, mut write) = tokio::io::split(client);
+    let mut read = BufReader::new(read);
+    send(
+        &mut write,
+        json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}}),
+    )
+    .await;
+    assert!(receive(&mut read).await.get("result").is_some());
+    send(
+        &mut write,
+        json!({"jsonrpc":"2.0","method":"initialized","params":{}}),
+    )
+    .await;
+    if concurrency == 4 {
+        send(&mut write, json!({"jsonrpc":"2.0","method":"probe/first"})).await;
+        send(&mut write, json!({"jsonrpc":"2.0","method":"probe/second"})).await;
+        send(
+            &mut write,
+            json!({"jsonrpc":"2.0","id":2,"method":"probe/barrier"}),
+        )
+        .await;
+        assert_eq!(receive(&mut read).await["result"], "barrier");
+        let events = state.events.lock().unwrap().clone();
+        assert_eq!(events, ["first started", "second finished"]);
+        println!("tower concurrency4 notification order before release: {events:?}");
+        state.release.notify_one();
+    } else {
+        send(
+            &mut write,
+            json!({"jsonrpc":"2.0","id":2,"method":"probe/slow"}),
+        )
+        .await;
+        timeout(Duration::from_secs(1), state.started.notified())
+            .await
+            .unwrap();
+        send(
+            &mut write,
+            json!({"jsonrpc":"2.0","method":"$/cancelRequest","params":{"id":2}}),
+        )
+        .await;
+        let response = timeout(Duration::from_millis(250), receive(&mut read)).await;
+        assert!(response.is_err());
+        println!("tower concurrency1 cancellation: no response within250ms");
+    }
+    task.abort();
+    let _ = task.await;
+}
+
+pub async fn probe() {
+    tower_probe(4).await;
+    tower_probe(1).await;
+    super::blocked_output::probe().await;
+    super::async_probe::probe(1).await;
+    super::async_probe::probe(2).await;
+}
