diff --git a/src/async_probe.rs b/src/async_probe.rs
new file mode 100644
--- /dev/null
+++ b/src/async_probe.rs
@@ -0,0 +1,137 @@
+use async_lsp::{
+    AnyEvent, AnyNotification, AnyRequest, LspService, concurrency::ConcurrencyLayer,
+    router::Router,
+};
+use futures::{AsyncReadExt, future::poll_fn};
+use serde_json::{Value, json};
+use std::{
+    num::NonZeroUsize,
+    ops::ControlFlow,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+    },
+    task::{Context, Poll},
+    time::Duration,
+};
+use tokio::{io::BufReader, sync::Notify, time::timeout};
+use tokio_util::compat::TokioAsyncReadCompatExt;
+use tower::Service;
+
+struct ProbeRequest;
+impl async_lsp::lsp_types::request::Request for ProbeRequest {
+    type Params = Value;
+    type Result = Value;
+    const METHOD: &'static str = "probe/request";
+}
+struct Observed<S> {
+    inner: S,
+    saturated: Arc<Notify>,
+}
+impl<S: LspService> Service<AnyRequest> for Observed<S> {
+    type Response = S::Response;
+    type Error = S::Error;
+    type Future = S::Future;
+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        let result = self.inner.poll_ready(cx);
+        if result.is_pending() {
+            self.saturated.notify_one();
+        }
+        result
+    }
+    fn call(&mut self, req: AnyRequest) -> Self::Future {
+        self.inner.call(req)
+    }
+}
+impl<S: LspService> LspService for Observed<S> {
+    fn notify(&mut self, value: AnyNotification) -> ControlFlow<async_lsp::Result<()>> {
+        self.inner.notify(value)
+    }
+    fn emit(&mut self, value: AnyEvent) -> ControlFlow<async_lsp::Result<()>> {
+        self.inner.emit(value)
+    }
+}
+#[derive(Default)]
+struct Gate {
+    ready: AtomicBool,
+    polls: AtomicUsize,
+    wakers: Mutex<Vec<std::task::Waker>>,
+    started: Notify,
+}
+
+pub async fn probe(limit: usize) {
+    let gate = Arc::new(Gate::default());
+    let signal = gate.clone();
+    let saturated = Arc::new(Notify::new());
+    let observation = saturated.clone();
+    let (main, _socket) = async_lsp::MainLoop::new_server(|_| {
+        let mut router = Router::new(());
+        router.request::<ProbeRequest, _>(move |_, _| {
+            let gate = signal.clone();
+            let mut first_poll = true;
+            poll_fn(move |cx| {
+                if first_poll {
+                    gate.polls.fetch_add(1, Ordering::SeqCst);
+                    gate.started.notify_one();
+                    first_poll = false;
+                }
+                gate.wakers.lock().unwrap().push(cx.waker().clone());
+                if gate.ready.load(Ordering::SeqCst) {
+                    Poll::Ready(Ok(json!("ready")))
+                } else {
+                    Poll::Pending
+                }
+            })
+        });
+        let inner = tower::ServiceBuilder::new()
+            .layer(ConcurrencyLayer::new(NonZeroUsize::new(limit).unwrap()))
+            .service(router);
+        Observed {
+            inner,
+            saturated: observation,
+        }
+    });
+    let (client, server) = tokio::io::duplex(65536);
+    let (input, output) = server.compat().split();
+    let task = tokio::spawn(async move { main.run_buffered(input, output).await });
+    let (read, mut write) = tokio::io::split(client);
+    let mut read = BufReader::new(read);
+    for id in [1, 2] {
+        super::framework::send(
+            &mut write,
+            json!({"jsonrpc":"2.0","id":id,"method":"probe/request","params":null}),
+        )
+        .await;
+    }
+    if limit == 1 {
+        timeout(Duration::from_secs(1), saturated.notified())
+            .await
+            .unwrap();
+    } else {
+        timeout(Duration::from_secs(1), async {
+            while gate.polls.load(Ordering::SeqCst) < 2 {
+                gate.started.notified().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
+    let polls = gate.polls.load(Ordering::SeqCst);
+    gate.ready.store(true, Ordering::SeqCst);
+    for waker in gate.wakers.lock().unwrap().drain(..) {
+        waker.wake();
+    }
+    let result = timeout(Duration::from_millis(250), async {
+        [
+            super::framework::receive(&mut read).await,
+            super::framework::receive(&mut read).await,
+        ]
+    })
+    .await;
+    assert_eq!(result.is_ok(), limit == 2);
+    println!(
+        "async-lsp limit{limit}: futures started={polls}, released=true, responses={result:?}"
+    );
+    task.abort();
+    let _ = task.await;
+}
