@@ -0,0 +1,121 @@
+use super::framework::{Backend, receive, send};
+use serde_json::json;
+use std::{
+    io,
+    pin::Pin,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    task::{Context, Poll, Waker},
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncWrite, BufReader},
+    sync::Notify,
+    time::timeout,
+};
+use tower_lsp_server::{LspService, Server};
+#[derive(Default)]
+struct Gate {
+    blocked: AtomicBool,
+    attempted: Notify,
+    waker: Mutex<Option<Waker>>,
+}
+struct Writer<W> {
+    inner: W,
+    gate: Arc<Gate>,
+}
+impl<W: AsyncWrite + Unpin> AsyncWrite for Writer<W> {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        if self.gate.blocked.load(Ordering::SeqCst) {
+            *self.gate.waker.lock().unwrap() = Some(cx.waker().clone());
+            self.gate.attempted.notify_one();
+            return Poll::Pending;
+        }
+        Pin::new(&mut self.inner).poll_write(cx, buf)
+    }
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.inner).poll_flush(cx)
+    }
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.inner).poll_shutdown(cx)
+    }
+}
+pub async fn probe() {
+    let backend = Backend {
+        events: Arc::default(),
+        release: Arc::default(),
+        started: Arc::default(),
+    };
+    let state = backend.clone();
+    let (service, socket) = LspService::build(|_| backend)
+        .custom_method("probe/answer", Backend::answer)
+        .custom_method("probe/barrier", Backend::barrier)
+        .finish();
+    let gate = Arc::new(Gate::default());
+    let (client, server) = tokio::io::duplex(65536);
+    let (input, output) = tokio::io::split(server);
+    let task = tokio::spawn(
+        Server::new(
+            input,
+            Writer {
+                inner: output,
+                gate: gate.clone(),
+            },
+            socket,
+        )
+        .serve(service),
+    );
+    let (read, mut write) = tokio::io::split(client);
+    let mut read = BufReader::new(read);
+    send(
+        &mut write,
+        json!({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"capabilities":{}}}),
+    )
+    .await;
+    assert!(receive(&mut read).await.get("result").is_some());
+    send(
+        &mut write,
+        json!({"jsonrpc":"2.0","method":"initialized","params":{}}),
+    )
+    .await;
+    gate.blocked.store(true, Ordering::SeqCst);
+    send(
+        &mut write,
+        json!({"jsonrpc":"2.0","id":2,"method":"probe/answer"}),
+    )
+    .await;
+    timeout(Duration::from_secs(1), gate.attempted.notified())
+        .await
+        .unwrap();
+    send(
+        &mut write,
+        json!({"jsonrpc":"2.0","method":"$/cancelRequest","params":{"id":2}}),
+    )
+    .await;
+    send(
+        &mut write,
+        json!({"jsonrpc":"2.0","id":3,"method":"probe/barrier"}),
+    )
+    .await;
+    timeout(Duration::from_secs(1), state.started.notified())
+        .await
+        .unwrap();
+    gate.blocked.store(false, Ordering::SeqCst);
+    if let Some(waker) = gate.waker.lock().unwrap().take() {
+        waker.wake();
+    }
+    let response = timeout(Duration::from_secs(1), receive(&mut read))
+        .await
+        .unwrap();
+    assert_eq!(response["id"], 2);
+    assert_eq!(response["result"], "answer");
+    println!("tower completed response, cancellation accepted before writer release: {response}");
+    task.abort();
+    let _ = task.await;
+}
