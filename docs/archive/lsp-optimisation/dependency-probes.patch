+use serde_json::{Value, json};
+
+// Preserve malformed-field errors while allowing unknown LSP extensions.
+#[derive(Debug, serde::Deserialize)]
+struct StrictChange {
+    range: Option<generated::Range>,
+    #[serde(rename = "rangeLength")]
+    range_length: Option<u32>,
+    text: String,
+}
+
+fn changes() {
+    let cases = [
+        ("valid full", json!({"text":"replacement"})),
+        (
+            "valid ranged",
+            json!({"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":1}},"text":"r"}),
+        ),
+        (
+            "range missing end",
+            json!({"range":{"start":{"line":0,"character":0}},"text":"replacement"}),
+        ),
+        (
+            "range wrong type",
+            json!({"range":true,"text":"replacement"}),
+        ),
+        (
+            "negative character",
+            json!({"range":{"start":{"line":0,"character":-1},"end":{"line":0,"character":1}},"text":"replacement"}),
+        ),
+        (
+            "rangeLength wrong type",
+            json!({"rangeLength":"bad","text":"replacement"}),
+        ),
+        (
+            "valid range bad length",
+            json!({"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":1}},"rangeLength":-1,"text":"replacement"}),
+        ),
+        (
+            "full with length",
+            json!({"rangeLength":1,"text":"replacement"}),
+        ),
+        ("range null", json!({"range":null,"text":"replacement"})),
+    ];
+    for (name, value) in cases {
+        let old = serde_json::from_value::<old::TextDocumentContentChangeEvent>(value.clone());
+        let strict = serde_json::from_value::<StrictChange>(value.clone());
+        assert_eq!(strict.is_ok(), old.is_ok());
+        if let Ok(strict) = &strict {
+            let old = old.as_ref().unwrap();
+            assert_eq!(strict.range_length, old.range_length);
+            assert_eq!(strict.text, old.text);
+            assert_eq!(
+                serde_json::to_value(strict.range).unwrap(),
+                serde_json::to_value(old.range).unwrap()
+            );
+        }
+        let new = serde_json::from_value::<generated::TextDocumentContentChangeEvent>(value);
+        assert!(new.is_ok());
+        println!(
+            "{name}: old={}, strict={}, generated={:?}",
+            old.is_ok(),
+            strict.is_ok(),
+            new
+        );
+    }
+    let batch = json!([
+        {"text":"poisoned"},
+        {"range":{"start":{"line":0,"character":0}},"text":"replacement"}
+    ]);
+    let old = serde_json::from_value::<Vec<old::TextDocumentContentChangeEvent>>(batch.clone());
+    let generated =
+        serde_json::from_value::<Vec<generated::TextDocumentContentChangeEvent>>(batch.clone());
+    let strict = serde_json::from_value::<Vec<StrictChange>>(batch);
+    assert!(old.is_err() && generated.is_ok() && strict.is_err());
+    println!(
+        "malformed second change: old={}, generated={}, strict={}",
+        old.is_ok(),
+        generated.is_ok(),
+        strict.is_ok()
+    );
+    for folders in [None, Some(Value::Null), Some(json!([]))] {
+        let mut input = json!({"processId":null,"rootUri":null,"capabilities":{}});
+        if let Some(folders) = folders {
+            input["workspaceFolders"] = folders;
+        }
+        let old = serde_json::from_value::<old::InitializeParams>(input.clone()).unwrap();
+        let new = serde_json::from_value::<generated::InitializeParams>(input.clone()).unwrap();
+        println!(
+            "initialize input={input}\nold={}\ngenerated={}",
+            serde_json::to_value(old).unwrap(),
+            serde_json::to_value(new).unwrap()
+        );
+    }
+}
+
+mod async_probe;
+mod blocked_output;
+mod framework;
+mod text;
+#[tokio::main(flavor = "current_thread")]
+async fn main() {
+    changes();
+    text::probe();
+    framework::probe().await;
+}
