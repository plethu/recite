+use old::{Position, Range, TextDocumentContentChangeEvent as Change};
+use textdocument::FullTextDocument;
+pub fn probe() {
+    let mut doc = FullTextDocument::new("recite".into(), 1, "a😀b".into());
+    let offset = doc.offset_at(Position::new(0, 2));
+    assert_eq!(offset, 1);
+    println!("textdocument surrogate-interior byte offset={offset} (rounded toscalarstart)");
+    let changes = [
+        Change {
+            range: None,
+            range_length: None,
+            text: "changed".into(),
+        },
+        Change {
+            range: Some(Range::new(Position::new(0, 3), Position::new(0, 1))),
+            range_length: None,
+            text: "x".into(),
+        },
+    ];
+    let outcome =
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| doc.update(&changes, 2)));
+    assert!(outcome.is_err());
+    assert_eq!(doc.get_content(None), "changed");
+    assert_eq!(doc.version(), 1);
+    println!(
+        "textdocument invalid batch: panicked after mutation; content={}, version={}",
+        doc.get_content(None),
+        doc.version()
+    );
+}
