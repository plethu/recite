-pub(crate) use accesskit_consumer::common_filter as filter;
+use accesskit_consumer::{common_filter, FilterResult, Node};
+
+/// A node is exposed only when the filtered traversal can reach it from the root.
+pub(crate) fn filter(node: &Node) -> FilterResult {
+    let result = common_filter(node);
+    if result == FilterResult::ExcludeSubtree {
+        return result;
+    }
+    // The upstream base cases for transparent and focused nodes return before
+    // checking ancestors. Initial registration still prunes those ancestor branches.
+    let mut parent = node.parent();
+    while let Some(ancestor) = parent {
+        if common_filter(&ancestor) == FilterResult::ExcludeSubtree {
+            return FilterResult::ExcludeSubtree;
+        }
+        parent = ancestor.parent();
+    }
+    result
+}
