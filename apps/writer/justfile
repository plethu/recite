set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set default-list
set working-directory := '../..'

# Launch the native writer, optionally with --project PATH.
run *args:
    cargo run --locked --manifest-path apps/writer/Cargo.toml -p recite-writer -- "$@"

# Verify the maintained writer and its source-editing model.
check:
    mise -E maintainability exec -- ast-grep scan --config tools/ast-grep/sgconfig.yml --filter '^rust-writer-(palette|cold-projections)$'
    just writer packaging
    cargo fmt --manifest-path apps/writer/Cargo.toml --all -- --check
    cargo fmt --manifest-path apps/writer/vendor/freya-code-editor/Cargo.toml --all -- --check
    cargo test --locked --manifest-path apps/writer/Cargo.toml --workspace
    cargo test --locked --manifest-path apps/writer/vendor/freya-code-editor/Cargo.toml
    cargo clippy --locked --manifest-path apps/writer/vendor/freya-code-editor/Cargo.toml --all-targets -- -D warnings
    cargo clippy --locked --manifest-path apps/writer/Cargo.toml --workspace --all-targets --all-features -- -D warnings -D clippy::excessive_nesting
    cargo clippy --locked --manifest-path apps/writer/Cargo.toml --workspace --all-features --lib --bins -- -D warnings -D clippy::cognitive_complexity -D clippy::excessive_nesting
    just writer heap

# Check package metadata and runtime dependencies without a host.
packaging:
    python3 tests/writer-packaging/check.py
    python3 scripts/package-writer.py --check-config > /dev/null
    python3 scripts/check-writer-flatpak.py

# Audit the separate Writer graph with the shared dependency policy.
supply-chain:
    cargo deny --locked --manifest-path apps/writer/Cargo.toml --all-features check advisories bans licenses sources

# Headless model and UI ownership have separate production-line floors.
coverage:
    cargo llvm-cov clean --manifest-path apps/writer/Cargo.toml --workspace
    cargo llvm-cov test --manifest-path apps/writer/Cargo.toml --workspace --locked --no-fail-fast --no-report -- --test-threads=4
    mkdir -p apps/writer/target/coverage
    for package in recite-writer-model recite-writer; do cargo llvm-cov report --manifest-path apps/writer/Cargo.toml --package "$package" --json --summary-only --ignore-filename-regex '/(tests|benches|examples)/' --fail-under-lines 90 --output-path "apps/writer/target/coverage/$package.json"; done

# Check keyboard, accessibility metadata, scaling, and contrast.
accessibility:
    mise -E maintainability exec -- ast-grep scan --config tools/ast-grep/sgconfig.yml --filter '^rust-writer-(palette|cold-projections)$'
    cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --test accessibility --test commands --test keybindings --test options --test picker --test text_input --test writing_workspace
    cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --lib design::
    cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --lib feedback::

# Probe Linux AT-SPI; needs python3-gi, dbus-run-session and a display. Bare Xvfb also needs xdotool and --headless-host x11.
probe-accessibility *args:
    cargo build --locked --manifest-path apps/writer/Cargo.toml -p recite-writer
    /usr/bin/python3 scripts/check-writer-native-accessibility.py apps/writer/target/debug/recite-writer --require-actions "$@"

# Probe native Wayland AT-SPI on a private software compositor; needs Cage and wtype.
probe-accessibility-wayland *args:
    #!/usr/bin/env bash
    set -euo pipefail
    runtime=$(mktemp -d /tmp/recite-wl.XXXXXXXX)
    trap 'rm -rf "$runtime"' EXIT
    env -u DISPLAY -u WAYLAND_DISPLAY -u WINIT_UNIX_BACKEND \
        XDG_RUNTIME_DIR="$runtime" WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 \
        WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman \
        cage -- env -u DISPLAY just writer probe-accessibility --headless-host wayland "$@"

# Check fixed-corpus allocation counts, without a wall-clock budget.
heap:
    cargo bench --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-model --features heap-profile --bench large_project -- --passages 10000 --check-heap
    cargo bench --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-model --features heap-profile --bench large_project -- --passages 10000 --check-heap --linked

# Profile the writer with perf (CPU) or DHAT (heap).
profile mode="cpu" passages="10000" output="/tmp/recite-writer-profile":
    scripts/profile-writer.sh "$1" "$2" "$3"

# Run a generated saved-project workload.
bench *args:
    cargo bench --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-model --features benchmarks --bench large_project -- "$@"

# Measure headless UI mounting and navigation timings.
bench-ui beats="1000":
    RECITE_BENCH_BEATS="$1" cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --test scale -- --ignored --nocapture

# Measure background draft queue, durable flush/reopen, and JSON serialization.
bench-recovery:
    cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --lib recovery::tests::background_recovery_timing -- --ignored --nocapture
    cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --lib recovery::encoding::tests::recovery_serialization_timing -- --ignored --nocapture

# Measure retained file sessions, edit history, saves and closing without a window.
bench-sessions passages="10000" visits="20":
    RECITE_BENCH_PASSAGES="$1" RECITE_BENCH_VISITS="$2" cargo test --release --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --lib project::sessions::tests::retained_project_sessions_preserve_edits_and_release_closed_owners -- --ignored --nocapture --test-threads=1

# Time geometry reconstruction for authored, linear and high-fan-out maps.
bench-map:
    cargo test --release --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --lib scene_map::layout::tests::map_geometry_reconstruction_timing -- --ignored --nocapture --test-threads=1

# Measure PO recovery, saves and queue filtering without a native window.
bench-catalogue entries="10000" edits="20":
    RECITE_BENCH_ENTRIES="$1" RECITE_BENCH_EDITS="$2" cargo test --release --locked --manifest-path apps/writer/Cargo.toml -p recite-writer --lib catalogue_ -- --ignored --nocapture --test-threads=1
