set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set default-list
set working-directory := '../..'

# Launch the native writer, optionally with --project PATH.
run *args:
    cargo run --locked --manifest-path apps/writer/Cargo.toml -p recite-writer -- "$@"

# Probe AT-SPI on an owned headless Wayland host; needs Cage, wtype, grim, wl-clipboard, python3-gi and D-Bus.
# The large-project scenario times an optimized build on a generated project against its budgets (#109).
probe output="target/writer-native/result.json" scenario="all":
    if [[ "$2" == large-project ]]; then \
      cargo build --locked --release -p recite-fixturegen; \
      cargo build --locked --profile bench --manifest-path apps/writer/Cargo.toml -p recite-writer; \
      binary=apps/writer/target/release/recite-writer; \
    else \
      cargo build --locked --manifest-path apps/writer/Cargo.toml -p recite-writer; \
      binary=apps/writer/target/debug/recite-writer; \
    fi; \
    /usr/bin/python3 tests/writer-native/check.py "$binary" "$1" --scenario "$2"

# Verify the maintained writer and its source-editing model.
check:
    mise -E maintainability exec -- ast-grep scan --config tools/ast-grep/sgconfig.yml --filter '^rust-writer-palette$'
    just writer packaging
    cargo fmt --manifest-path apps/writer/Cargo.toml --all -- --check
    cargo test --locked --manifest-path apps/writer/Cargo.toml --workspace
    cargo clippy --locked --manifest-path apps/writer/Cargo.toml --workspace --all-targets --all-features -- -D warnings -D clippy::excessive_nesting
    cargo clippy --locked --manifest-path apps/writer/Cargo.toml --workspace --all-features --lib --bins -- -D warnings -D clippy::cognitive_complexity -D clippy::excessive_nesting
    just writer heap

# Check package metadata and runtime dependencies without a host.
packaging *args:
    python3 tests/writer-packaging/check.py
    python3 scripts/package-writer.py --check-config > /dev/null
    python3 scripts/check-writer-flatpak.py "$@"

# Audit the separate Writer graph with the shared dependency policy.
supply-chain:
    cargo deny --locked --manifest-path apps/writer/Cargo.toml --all-features check advisories bans licenses sources

# Headless model and UI ownership have separate production-line floors.
coverage:
    cargo llvm-cov clean --manifest-path apps/writer/Cargo.toml --workspace
    cargo llvm-cov test --manifest-path apps/writer/Cargo.toml --workspace --locked --no-fail-fast --no-report -- --test-threads=4
    mkdir -p apps/writer/target/coverage
    for package in recite-writer-model recite-writer-session recite-writer-app recite-writer; do cargo llvm-cov report --manifest-path apps/writer/Cargo.toml --package "$package" --json --summary-only --ignore-filename-regex '/(tests|benches|examples)/' --fail-under-lines 90 --output-path "apps/writer/target/coverage/$package.json"; done

# Check fixed-corpus allocation counts, without a wall-clock budget.
heap:
    cargo bench --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-model --features heap-profile --bench large_project -- --passages 10000 --check-heap
    cargo bench --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-model --features heap-profile --bench large_project -- --passages 10000 --check-heap --linked

# Profile the writer with perf (CPU) or DHAT (heap).
profile mode="cpu" passages="10000" output="/tmp/recite-writer-profile":
    scripts/profile-writer.sh "$1" "$2" "$3"

# Run one Writer workload: project (default; arguments go to the benchmark), recovery, map,
# sessions [PASSAGES=10000 VISITS=20] or catalogue [ENTRIES=10000 EDITS=20]. All run without a window.
#   project:   generated saved-project workload
#   recovery:  background draft queue, durable flush/reopen and JSON serialization
#   sessions:  retained file sessions, edit history, saves and closing
#   map:       geometry reconstruction for authored, linear and high-fan-out maps
#   catalogue: PO recovery, saves and queue filtering
bench scenario="project" *args:
    #!/usr/bin/env bash
    set -euo pipefail
    scenario="$1"
    shift
    session_test() { cargo test --release --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-session --lib "$1" -- --ignored --nocapture --test-threads=1; }
    case "$scenario" in
        project) cargo bench --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-model --features benchmarks --bench large_project -- "$@" ;;
        recovery)
            cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-session --lib recovery::tests::background_recovery_timing -- --ignored --nocapture
            cargo test --locked --manifest-path apps/writer/Cargo.toml -p recite-writer-session --lib recovery::encoding::tests::recovery_serialization_timing -- --ignored --nocapture ;;
        sessions) RECITE_BENCH_PASSAGES="${1:-10000}" RECITE_BENCH_VISITS="${2:-20}" session_test project::sessions::tests::retained_project_sessions_preserve_edits_and_release_closed_owners ;;
        map) session_test map::layout::tests::map_geometry_reconstruction_timing ;;
        catalogue) RECITE_BENCH_ENTRIES="${1:-10000}" RECITE_BENCH_EDITS="${2:-20}" session_test catalogue_ ;;
        *) echo 'Expected project, recovery, sessions, map, or catalogue' >&2; exit 2 ;;
    esac
