[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/librecite_godot.so"
linux.release.x86_64 = "res://bin/librecite_godot.so"
macos.debug = "res://bin/librecite_godot.dylib"
macos.release = "res://bin/librecite_godot.dylib"
windows.debug.x86_64 = "res://bin/recite_godot.dll"
windows.release.x86_64 = "res://bin/recite_godot.dll"
