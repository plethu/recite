msgctxt "ffee6p8"
msgid "LACUNA comes through the carrier in winter static, saying the minister was dead before the train arrived."
msgstr "LACUNA comes through the carrier in winter static, saying the minister was dead before the train arrived."

msgctxt "wpgvzx4"
msgid "Ask her to wait while you thread the wire recording."
msgstr "Ask her to wait while you thread the wire recording."

msgctxt "hear_lacuna"
msgid "Let LACUNA give the account in her own order."
msgstr "Let LACUNA give the account in her own order."

msgctxt "query_console"
msgid "Set the radiocomputer to compare the station clocks."
msgstr "Set the radiocomputer to compare the station clocks."

msgctxt "t3key0n"
msgid "The wire carries a second breath beneath hers, too regular to be fear."
msgstr "The wire carries a second breath beneath hers, too regular to be fear."

msgctxt "trusted_line"
msgid "OPERATOR, you know my silences. This one was bought, not chosen."
msgstr "OPERATOR, you know my silences. This one was bought, not chosen."

msgctxt "relationship_prompt"
msgid "You can hear her, or you can hear the evidence that refuses her."
msgstr "You can hear her, or you can hear the evidence that refuses her."

msgctxt "notice_01"
msgid "Clock notice: Meridian Station reports minute zero before the embassy relay."
msgstr "Clock notice: Meridian Station reports minute zero before the embassy relay."

msgctxt "notice_02"
msgid "Wire notice: the recorder head was reversed after the first spoken name."
msgstr "Wire notice: the recorder head was reversed after the first spoken name."

msgctxt "notice_03"
msgid "Seal notice: diplomatic wax contains railway grit from the eastern loop."
msgstr "Seal notice: diplomatic wax contains railway grit from the eastern loop."

msgctxt "notice_04"
msgid "Clerk notice: the station log omits one passenger with military clearance."
msgstr "Clerk notice: the station log omits one passenger with military clearance."

msgctxt "notice_05"
msgid "Cipher notice: LACUNA's card answers to a bureau key retired in 1919."
msgstr "Cipher notice: LACUNA's card answers to a bureau key retired in 1919."

msgctxt "localization_prompt"
msgid "The lamps sort the night into proofs, but none of them say why she called."
msgstr "The lamps sort the night into proofs, but none of them say why she called."

msgctxt "effects_line"
msgid "I can burn the comparison to oxide tape, but the console will demand your cipher key."
msgstr "I can burn the comparison to oxide tape, but the console will demand your cipher key."

msgctxt "effects_prompt"
msgid "The case is no longer clean, only legible."
msgstr "The case is no longer clean, only legible."

msgctxt "deferred_anchor_line"
msgid "Deferred comparison queued for the Lamplight file."
msgstr "Deferred comparison queued for the Lamplight file."

