:: m0 default
:match stage(player)
  :case early
    > @l0
      Tomorrow sure.
  :case late
    > @l1
      Fresh l1.
:match stage(player)
  :case early
    > speaker=s0 bind=(count:int=$count) @l2
      Count {count}, Onward onward.
      ? requires=(ready() or ready() or flag(player)) @c3
        Onward rain.
        -> dialogue/side.recite::s0
  :case _
    ! blocking grant(player)
    > speaker=s1 @l4
      Wait wait.
    :match mood()
      :case wary
        > @l5
          Tomorrow hello.
        > speaker=s1 @l6
          Hello tomorrow.
        ! immediate ping()
      :case _
        > speaker=s1 @l7
          Wait maybe.
        > @l8
          Maybe wait.
        > speaker=s1 @l9
          Sure rain.
        > speaker=s0 bind=(count:int=$count) @l10
          Count {count}, Hello quiet.
          ? requires=(ready() or flag(rhea)) @c11
            Sure hello.
            -> dialogue/side.recite::s1
          ? requires=(ready()) @c12
            Tomorrow onward.
            -> m1
! blocking note(player)
-> dialogue/side.recite::s1

:: m1
? requires=(not flag(player)) @c13
  Tomorrow onward.
  -> dialogue/side.recite::s1
# between choices
? requires=(flag(rhea) or flag(rhea)) @c14
  Maybe rain.
  -> dialogue/side.recite::s0
