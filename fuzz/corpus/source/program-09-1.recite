:: s0
> speaker=s1 bind=(count:int=$count) @l0
  Count {count}, Tomorrow wait.
-> s1

:: s1
:if ready() or flag(player) or flag(rhea)
  :match stage(player)
    :case late
      > speaker=s1 @l1
        Sure hello.
        ? @c2
          Maybe wait.
          -> END
        ? @c3
          Onward quiet.
          -> s1
        ? requires=((not flag(player)) and ready() and ready()) @c4
          Rain rain.
          -> END
    :case early
      ! deferred note(player)
      > @l5
        Rain wait.
    :case _
      > @l6
        Fresh l6.
      # generated comment
  ! blocking grant(rhea)
  > @l7
    Wait sure.
  -> END
? requires=((flag(rhea) or ready()) or ready()) @c8
  Rain sure.
  -> dialogue/main.recite::m0
