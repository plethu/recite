:: m0 default
> @l0
  Quiet maybe.
> speaker=s1 @l1
  Sure quiet.
> @l2
  Hello sure.

:: m1
> bind=(count:int=$count) @l3
  Count {count}, Quiet maybe.
:if ready()
  :match stage(player)
    :case late
      > @l4
        Fresh l4.
    :case early
      > @l5
        Wait quiet.
      # generated comment
      > bind=(count:int=$count) @l6
        Count {count}, Sure quiet.
      -> m2
  > bind=(count:int=$count) @l7
    Count {count}, Maybe tomorrow.
  :match mood()
    :case tired
      > @l8
        Wait onward.
      ! immediate ping()
      > speaker=s1 @l9
        Maybe hello.
      > speaker=s0 @l10
        Wait hello.
        ? requires=(ready() or ready() or flag(rhea)) @c11
          Maybe rain.
          -> m3
    :case wary
      # generated comment
      > @l12
        Tomorrow sure.
    :case calm
      > speaker=s0 @l13
        Sure maybe.
      ! deferred note(player)
      > @l14
        Sure rain.
      ? requires=(flag(player) or (flag(player) or flag(player)) or ready()) @c15
        Tomorrow sure.
        -> m3
      # between choices
      ? requires=(flag(player) or flag(rhea) or ready()) @c16
        Quiet onward.
        -> m3
  -> m2
:else
  :match mood()
    :case calm
      ! blocking grant(rhea)
    :case tired
      ? requires=(ready() and ready() and flag(rhea)) @c17
        Sure onward.
        -> m2
    :case _
      ! immediate note(rhea)
      # generated comment
      > speaker=s1 @l18
        Rain sure.
  :match stage(player)
    :case early
      ! blocking grant(player)
      > @l19
        Quiet rain.
      -> dialogue/side.recite::s0
    :case late
      > @l20
        Fresh l20.
    :case _
      > @l21
        Sure wait.
      > @l22
        Onward quiet.
  > bind=(count:int=$count) @l23
    Count {count}, Hello wait.
    ? requires=(flag(rhea) or flag(player) or ready()) @c24
      Hello onward.
      -> m2
    ? @c25
      Rain maybe.
      -> m0
# generated comment

:: m2
> speaker=s1 @l26
  Rain sure.
! immediate ping()
> bind=(count:int=$count) @l27
  Count {count}, Hello tomorrow.
> @l28
  Maybe hello.
  ? requires=(ready() or flag(rhea) or flag(player)) @c29
    Hello rain.
    -> END
  ? @c30
    Tomorrow sure.
    -> END

:: m3
! immediate note(rhea)
> @l31
  Rain wait.
