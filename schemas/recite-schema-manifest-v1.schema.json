{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeberg.org/plethu/recite/raw/branch/main/schemas/recite-schema-manifest-v1.schema.json",
  "title": "Recite generated schema manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "types": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/typeDefinition" }
    },
    "registries": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/registryDefinition" }
    },
    "speakers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/speakerDefinition" }
    },
    "conditions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/conditionDefinition" }
    },
    "effects": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/effectDefinition" }
    },
    "metadata_domains": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/metadataDomainDefinition" }
    },
    "metadata": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/metadataDefinition" }
    },
    "markup": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/definitionName" },
      "additionalProperties": { "$ref": "#/$defs/markupDefinition" }
    }
  },
  "$defs": {
    "definitionName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "typeReference": {
      "type": "string",
      "pattern": "^(string|symbol|int|float|bool|speaker|enum:[A-Za-z_][A-Za-z0-9_.-]*|registry:[A-Za-z_][A-Za-z0-9_.-]*)$"
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/definitionName" },
        "type": { "$ref": "#/$defs/typeReference" }
      }
    },
    "typeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": { "const": "enum" },
        "values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "registryDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "origin": { "type": "string", "minLength": 1 }
      }
    },
    "speakerDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "conditionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" },
          "default": []
        },
        "returns": {
          "type": "string",
          "pattern": "^(bool|enum:[A-Za-z_][A-Za-z0-9_.-]*)$",
          "default": "bool"
        }
      }
    },
    "effectDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "items": { "enum": ["deferred", "immediate", "blocking"] }
        },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" },
          "default": []
        }
      }
    },
    "metadataDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "type"],
      "properties": {
        "targets": {
          "type": "array",
          "items": { "enum": ["block", "choice", "line", "project"] }
        },
        "type": { "$ref": "#/$defs/typeReference" },
        "repeatable": { "type": "boolean", "default": false },
        "domain": { "$ref": "#/$defs/definitionName" }
      }
    },
    "metadataDomainDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/flatMetadataDomainDefinition" },
        { "$ref": "#/$defs/contextualMetadataDomainDefinition" }
      ]
    },
    "flatMetadataDomainDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": { "const": "flat" },
        "values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contextualMetadataDomainDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "values_by_context"],
      "properties": {
        "kind": { "const": "contextual" },
        "selector": {
          "type": "string",
          "pattern": "^(field:speaker|metadata:[A-Za-z_][A-Za-z0-9_.-]*)$"
        },
        "values_by_context": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/definitionName" },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "missing_context": { "$ref": "#/$defs/missingMetadataContext" }
      }
    },
    "missingMetadataContext": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": { "enum": ["diagnostic", "empty"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "domain"],
          "properties": {
            "policy": { "const": "fallback" },
            "domain": { "$ref": "#/$defs/definitionName" }
          }
        }
      ]
    },
    "markupDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_closing", "translatable"],
      "properties": {
        "requires_closing": { "type": "boolean" },
        "translatable": { "type": "boolean" },
        "allows_nesting": { "type": "boolean", "default": true }
      }
    }
  }
}
